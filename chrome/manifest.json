{
  "manifest_version": 3,
  "name": "网易云听歌同步飞书签名",
  "version": "3.0.0",
  "description": "按设定的每日时间，将网易云最近播放的一首歌同步到自己的飞书签名。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "cookies",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://login.feishu.cn/*",
    "https://internal-api-lark-api.feishu.cn/*",
    "https://music.163.com/*",
    "https://*.music.163.com/*"
  ],
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "网易云听歌同步飞书签名",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  }
}
